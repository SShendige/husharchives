# Environment Variables Example for HUSH ARCHIVE
# Copy this file to .env and fill in real values before starting the server.

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@localhost:5432/husharchive?schema=public"

# Admin Authentication Secret Key
# REQUIRED — must be a long random string (minimum 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server will refuse to start if this is missing or empty.
JWT_SECRET="replace-with-a-secure-random-secret-key"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Admin Seed Password (optional)
# Only used the first time `npm run seed` is executed when no admin account exists.
# If not set, a random password is generated and printed once to the console.
# Has no effect once an admin account already exists — the seed script never
# resets or overwrites an existing administrator's password.
# ADMIN_SEED_PASSWORD="your-initial-admin-password"
